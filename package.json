{
  "name": "sudoku-viz",
  "version": "0.0.1",
  "description": "Typescript app to visualize sudoku puzzles",
  "type": "module",
  "engines": {
    "node": ">= 18.12 <19"
  },
  "author": "Owen Schoppe <oschoppe@users.noreply.github.com>",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "r:dev": "npm-run-all --parallel r:reload r:start r:watch",
    "r:build": "rollup -c",
    "r:start": "serve dist",
    "r:watch": "rollup -c -w",
    "r:reload": "livereload dist/ -p 5001",
    "r:deploy": "yarn r:deploy:list && gcloud --project sudoku-viz app deploy",
    "r:deploy:list": "gcloud meta list-files-for-upload",
    "lint": "eslint . --ext .ts --ext .mts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-html": "^1.0.2",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.1",
    "@types/html-minifier": "^4.0",
    "@types/jest": "~29.5",
    "@types/node": "~18",
    "@typescript-eslint/eslint-plugin": "~5.59",
    "@typescript-eslint/parser": "~5.59",
    "autoprefixer": "^10.4.16",
    "caniuse-lite": "^1.0.30000697",
    "cssnano": "^6.0.1",
    "eslint": "~8.51",
    "eslint-config-prettier": "~8.8",
    "eslint-plugin-jest": "~27.2",
    "jest": "~29.5",
    "livereload": "^0.9.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "postcss-cssnext": "^3.1.1",
    "postcss-custom-properties": "^13.3.2",
    "postcss-preset-env": "^9.2.0",
    "prettier": "~2.8",
    "rimraf": "~5.0",
    "rollup": "^3.25.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-html2": "^4.0.0",
    "rollup-plugin-import-css": "^3.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-string": "^3.0.0",
    "serve": "^11.3.2",
    "ts-api-utils": "~0.0.44",
    "ts-jest": "~29.1",
    "typescript": "^5.1.3"
  }
}
