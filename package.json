{
  "name": "sudoku-viz",
  "version": "0.0.1",
  "description": "Typescript app to visualize sudoku puzzles",
  "type": "module",
  "engines": {
    "node": ">= 18.12 <19"
  },
  "author": "Owen Schoppe <oschoppe@users.noreply.github.com>",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "node build/src/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "npm run lint",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:release": "npm run clean && tsc -p tsconfig.release.json",
    "lint": "eslint . --ext .ts --ext .mts",
    "test": "jest --coverage",
    "prettier": "prettier --config .prettierrc --write .",
    "test:watch": "jest --watch",
    "r:build": "rollup -c",
    "r:watch": "rollup -c -w",
    "r:dev": "npm-run-all --parallel r:reload r:start r:watch",
    "r:start": "serve dist",
    "r:reload": "livereload dist/ -p 5001"
  },
  "dependencies": {
    "rollup-plugin-serve": "^2.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-html": "^1.0.2",
    "@rollup/plugin-node-resolve": "^11.1.0",
    "@rollup/plugin-typescript": "^11.1.1",
    "@types/jest": "~29.5",
    "@types/node": "~18",
    "@typescript-eslint/eslint-plugin": "~5.59",
    "@typescript-eslint/parser": "~5.59",
    "eslint": "~8.38",
    "eslint-config-prettier": "~8.8",
    "eslint-plugin-jest": "~27.2",
    "jest": "~29.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.24",
    "prettier": "~2.8",
    "rimraf": "~5.0",
    "rollup": "^3.25.1",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-import-css": "^3.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^8.2.15",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "serve": "^11.3.2",
    "ts-api-utils": "~0.0.44",
    "ts-jest": "~29.1",
    "typescript": "^5.1.3"
  }
}
